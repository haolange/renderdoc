{
  "version": "1.0",
  "description": "Renderdoc Debug Agent MCP工具映射配置",
  "sop_mcp_mapping": {
    "SOP-NAN-01": {
      "name": "NaN/Inf问题排查",
      "stages": [
        {
          "stage_id": 1,
          "stage_name": "检测与定位",
          "mcp_tools": [
            {
              "tool": "rd.texture.get_data",
              "description": "获取问题像素的原始纹理数据",
              "params": {
                "resource_id": "需要分析的纹理资源ID",
                "subresource": 0,
                "x": "像素X坐标",
                "y": "像素Y坐标",
                "width": 1,
                "height": 1
              }
            },
            {
              "tool": "rd.event.get_pixels",
              "description": "获取像素历史，追踪NaN来源",
              "params": {
                "event_id": "目标事件ID",
                "x": "像素X坐标",
                "y": "像素Y坐标"
              }
            }
          ]
        },
        {
          "stage_id": 2,
          "stage_name": "根因分析",
          "mcp_tools": [
            {
              "tool": "rd.shader.get_source",
              "description": "获取可疑Shader源码",
              "params": {
                "event_id": "事件ID",
                "stage": "PS"
              }
            },
            {
              "tool": "rd.shader.get_debug",
              "description": "获取Shader调试信息，分析NaN源",
              "params": {
                "event_id": "事件ID",
                "x": "像素X坐标",
                "y": "像素Y坐标"
              }
            }
          ]
        },
        {
          "stage_id": 3,
          "stage_name": "验证修复",
          "mcp_tools": [
            {
              "tool": "rd.texture.get_data",
              "description": "验证修复后问题区域",
              "params": {
                "resource_id": "渲染目标ID",
                "x": "原问题像素X",
                "y": "原问题像素Y"
              }
            }
          ]
        }
      ]
    },
    "SOP-GEO-01": {
      "name": "几何问题排查",
      "stages": [
        {
          "stage_id": 1,
          "stage_name": "识别问题类型",
          "mcp_tools": [
            {
              "tool": "rd.event.get_actions",
              "description": "获取所有Draw Call",
              "params": {}
            },
            {
              "tool": "rd.pipeline.get_raster_state",
              "description": "获取光栅化状态（含剔除设置）",
              "params": {
                "event_id": "事件ID"
              }
            }
          ]
        },
        {
          "stage_id": 2,
          "stage_name": "分析剔除状态",
          "mcp_tools": [
            {
              "tool": "rd.resource.get_details",
              "description": "检查顶点/索引缓冲",
              "params": {
                "resource_id": "几何资源ID"
              }
            },
            {
              "tool": "rd.pipeline.get_vertex_input",
              "description": "获取顶点输入状态",
              "params": {
                "event_id": "事件ID"
              }
            }
          ]
        }
      ]
    },
    "SOP-COLOR-01": {
      "name": "颜色空间问题排查",
      "stages": [
        {
          "stage_id": 1,
          "stage_name": "颜色空间诊断",
          "mcp_tools": [
            {
              "tool": "rd.texture.get_data",
              "description": "获取纹理原始数据",
              "params": {
                "resource_id": "纹理ID"
              }
            },
            {
              "tool": "rd.pipeline.get_blend_state",
              "description": "检查混合状态",
              "params": {
                "event_id": "事件ID"
              }
            }
          ]
        },
        {
          "stage_id": 2,
          "stage_name": "Gamma分析",
          "mcp_tools": [
            {
              "tool": "rd.shader.get_source",
              "description": "获取Shader源码分析Gamma处理",
              "params": {
                "event_id": "事件ID",
                "stage": "PS"
              }
            },
            {
              "tool": "rd.pipeline.get_state",
              "description": "获取管线状态",
              "params": {
                "event_id": "事件ID"
              }
            }
          ]
        }
      ]
    },
    "SOP-TEX-01": {
      "name": "纹理问题排查",
      "stages": [
        {
          "stage_id": 1,
          "stage_name": "纹理基础检查",
          "mcp_tools": [
            {
              "tool": "rd.texture.get_info",
              "description": "获取纹理基本信息（格式、大小、Mipmap级别）",
              "params": {
                "texture_id": "纹理ID"
              }
            },
            {
              "tool": "rd.texture.get_data",
              "description": "获取纹理原始数据",
              "params": {
                "texture_id": "纹理ID",
                "mip": 0,
                "slice": 0
              }
            }
          ]
        },
        {
          "stage_id": 2,
          "stage_name": "UV坐标检查",
          "mcp_tools": [
            {
              "tool": "rd.shader.get_debug",
              "description": "获取Shader调试信息，检查UV计算",
              "params": {
                "event_id": "事件ID",
                "x": "像素X坐标",
                "y": "像素Y坐标"
              }
            },
            {
              "tool": "rd.pipeline.get_state",
              "description": "获取当前管线状态",
              "params": {
                "event_id": "事件ID"
              }
            }
          ]
        },
        {
          "stage_id": 3,
          "stage_name": "Mipmap检查",
          "mcp_tools": [
            {
              "tool": "rd.texture.get_data",
              "description": "获取不同Mipmap级别的纹理数据",
              "params": {
                "texture_id": "纹理ID",
                "mip": "指定Mipmap级别"
              }
            },
            {
              "tool": "rd.frame.compare",
              "description": "比较不同事件的纹理结果",
              "params": {
                "event1": "事件ID1",
                "event2": "事件ID2"
              }
            }
          ]
        },
        {
          "stage_id": 4,
          "stage_name": "验证",
          "mcp_tools": [
            {
              "tool": "rd.texture.get_info",
              "description": "验证纹理配置",
              "params": {
                "texture_id": "纹理ID"
              }
            },
            {
              "tool": "rd.shader.get_debug",
              "description": "验证最终Shader结果",
              "params": {
                "event_id": "事件ID",
                "x": "像素X坐标",
                "y": "像素Y坐标"
              }
            }
          ]
        }
      ]
    },
    "SOP-DEPTH-01": {
      "name": "深度缓冲问题排查",
      "stages": [
        {
          "stage_id": 1,
          "stage_name": "深度缓冲可视化",
          "mcp_tools": [
            {
              "tool": "rd.texture.get_data",
              "description": "获取深度缓冲数据",
              "params": {
                "resource_id": "深度缓冲ID",
                "subresource": 0
              }
            },
            {
              "tool": "rd.pipeline.get_depth_state",
              "description": "获取深度测试状态",
              "params": {
                "event_id": "事件ID"
              }
            }
          ]
        },
        {
          "stage_id": 2,
          "stage_name": "深度状态检查",
          "mcp_tools": [
            {
              "tool": "rd.pipeline.get_state",
              "description": "获取完整管线状态",
              "params": {
                "event_id": "事件ID"
              }
            },
            {
              "tool": "rd.event.get_pixels",
              "description": "获取特定像素的深度历史",
              "params": {
                "event_id": "事件ID",
                "x": "像素X坐标",
                "y": "像素Y坐标"
              }
            }
          ]
        },
        {
          "stage_id": 3,
          "stage_name": "Z-Fighting分析",
          "mcp_tools": [
            {
              "tool": "rd.shader.get_debug",
              "description": "分析Shader中的深度计算",
              "params": {
                "event_id": "事件ID",
                "x": "像素X坐标",
                "y": "像素Y坐标"
              }
            },
            {
              "tool": "rd.pipeline.get_raster_state",
              "description": "获取光栅化状态",
              "params": {
                "event_id": "事件ID"
              }
            }
          ]
        },
        {
          "stage_id": 4,
          "stage_name": "验证",
          "mcp_tools": [
            {
              "tool": "rd.texture.get_data",
              "description": "验证深度缓冲修复结果",
              "params": {
                "resource_id": "深度缓冲ID"
              }
            }
          ]
        }
      ]
    },
    "SOP-PREC-01": {
      "name": "精度问题排查",
      "stages": [
        {
          "stage_id": 1,
          "stage_name": "精度损失识别",
          "mcp_tools": [
            {
              "tool": "rd.frame.take_screenshot",
              "description": "截取当前帧用于精度分析",
              "params": {}
            },
            {
              "tool": "rd.pipeline.get_state",
              "description": "获取管线状态检查渲染目标格式",
              "params": {
                "event_id": "事件ID"
              }
            }
          ]
        },
        {
          "stage_id": 2,
          "stage_name": "Shader精度分析",
          "mcp_tools": [
            {
              "tool": "rd.shader.get_source",
              "description": "获取Shader源码检查精度操作",
              "params": {
                "event_id": "事件ID",
                "stage": "PS"
              }
            },
            {
              "tool": "rd.shader.get_debug",
              "description": "调试Shader执行获取中间值精度",
              "params": {
                "event_id": "事件ID",
                "x": "像素X坐标",
                "y": "像素Y坐标"
              }
            }
          ]
        },
        {
          "stage_id": 3,
          "stage_name": "RT格式验证",
          "mcp_tools": [
            {
              "tool": "rd.pipeline.get_state",
              "description": "获取渲染目标格式信息",
              "params": {
                "event_id": "事件ID"
              }
            },
            {
              "tool": "rd.texture.get_info",
              "description": "获取纹理格式详情",
              "params": {
                "texture_id": "纹理ID"
              }
            }
          ]
        },
        {
          "stage_id": 4,
          "stage_name": "验证",
          "mcp_tools": [
            {
              "tool": "rd.frame.take_screenshot",
              "description": "验证精度修复后的结果",
              "params": {}
            }
          ]
        }
      ]
    },
    "SOP-PERF-01": {
      "name": "性能问题排查",
      "stages": [
        {
          "stage_id": 1,
          "stage_name": "瓶颈识别",
          "mcp_tools": [
            {
              "tool": "rd.api.get_log",
              "description": "获取API调用日志分析性能",
              "params": {
                "from": "开始事件ID",
                "to": "结束事件ID"
              }
            },
            {
              "tool": "rd.resource.get_transitions",
              "description": "获取资源转换信息",
              "params": {}
            }
          ]
        },
        {
          "stage_id": 2,
          "stage_name": "Pipeline Stall分析",
          "mcp_tools": [
            {
              "tool": "rd.pipeline.get_state",
              "description": "获取管线状态分析Stall",
              "params": {
                "event_id": "事件ID"
              }
            },
            {
              "tool": "rd.event.get_actions",
              "description": "获取事件操作详情",
              "params": {}
            }
          ]
        },
        {
          "stage_id": 3,
          "stage_name": "优化验证",
          "mcp_tools": [
            {
              "tool": "rd.api.get_log",
              "description": "验证优化后的API调用序列",
              "params": {
                "from": "开始事件ID",
                "to": "结束事件ID"
              }
            }
          ]
        }
      ]
    }
  },
